# ===== Server =====
NODE_ENV=development
PORT=4000
# Number of trusted reverse-proxy hops. Keep 0 for direct local access; use 1 behind the bundled proxy.
TRUST_PROXY_HOPS=0
# Maximum time for active HTTP requests to finish during shutdown.
SHUTDOWN_TIMEOUT_MS=10000
PUBLIC_APP_URL=http://localhost:5173
STAFF_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5173
SERVER_ORIGIN=http://localhost:4000
# Leave empty for host-only cookies (localhost and LAN demo).
COOKIE_DOMAIN=
COOKIE_SECURE=false
LOG_LEVEL=info
# Optional stable name in logs/metrics. If empty, the operating-system/container hostname is used.
INSTANCE_ID=
# unified khi chạy dev; Compose production tự gán guest/internal cho từng backend pool.
TRAFFIC_CLASS=unified

# MongoDB (replica set for transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/maycafe?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_GUEST_MUTATION_MAX=60
RATE_LIMIT_GUEST_JOIN_MAX=20
RATE_LIMIT_GUEST_ORDER_MAX=12
RATE_LIMIT_GUEST_SERVICE_MAX=6
RATE_LIMIT_MENU_SEARCH_MAX=120
RATE_LIMIT_AI_MAX=20
MENU_CACHE_TTL_SECONDS=60
ORDER_QUOTE_TTL_MS=120000

# Worker queue: báo cáo/export và thông báo realtime.
BACKGROUND_JOB_POLL_MS=250
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_RESULT_TTL_SECONDS=900
BACKGROUND_JOB_RESULT_MAX_BYTES=5242880
BACKGROUND_JOB_LEASE_MS=30000
BACKGROUND_JOB_RETRY_BASE_MS=1000
BACKGROUND_JOB_RETRY_MAX_MS=60000
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_MS=20000
WORKER_ROLE=all

# Transactional outbox: MongoDB giữ sự kiện đến khi chuyển được sang Redis queue.
OUTBOX_POLL_MS=250
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000

# Giới hạn tài nguyên Compose production (có thể chỉnh theo cấu hình máy).
GUEST_API_CPUS=0.75
GUEST_API_MEMORY_LIMIT=384m
GUEST_API_MEMORY_RESERVATION=192m
INTERNAL_API_CPUS=0.75
INTERNAL_API_MEMORY_LIMIT=384m
INTERNAL_API_MEMORY_RESERVATION=192m
WORKER_CPUS=0.50
WORKER_MEMORY_LIMIT=384m
WORKER_MEMORY_RESERVATION=192m
WEB_CPUS=0.50
WEB_MEMORY_LIMIT=192m
WEB_MEMORY_RESERVATION=64m

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Demo seed
SEED_DEMO_PASSWORD=MayCafe@2025

# ===== Phiên bàn =====
# Khách quét QR tự mở phiên (false = quay lại hành vi 403 "bàn chưa mở phiên")
GUEST_AUTO_OPEN=true
# Tự đóng phiên tự mở không có đơn sau N phút (0 = tắt)
SESSION_IDLE_TIMEOUT_MIN=60

# ===== AI =====
# Dev backend reads server/.env. Restart API/worker after changing these values.
# AI_MODE: live | fallback | off. Live tries the provider, then falls back on runtime errors.
AI_MODE=fallback
# Anomaly inference is opt-in, independent of Barista; off does not disable detection.
ANOMALY_AI_MODE=fallback
AI_PROVIDER=openai
# Required explicit raw model ID when either mode is live; no automatic model selection.
AI_MODEL=
AI_API_KEY=
# Base URL, not the full /chat/completions endpoint. Key stays on the backend.
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
# Zen example: AI_PROVIDER=opencode-zen, AI_BASE_URL=https://opencode.ai/zen/v1
# AI_MODEL=space-bunny-free (verify access and JSON mode before use).

# Anomaly detector (P4B). Dùng aggregate có bằng chứng; AI chỉ giải thích cảnh báo mới.
ANOMALY_ENABLED=true
ANOMALY_INTERVAL_MS=60000
ANOMALY_WINDOW_MIN=15
ANOMALY_BASELINE_MIN=60
ANOMALY_MIN_SAMPLES=20
ANOMALY_ERROR_RATE=0.1
ANOMALY_LATENCY_P95_MS=1000
ANOMALY_PREPARATION_P95_SECONDS=900
ANOMALY_CANCELLATION_RATE=0.25
ANOMALY_BASELINE_MULTIPLIER=2
ANOMALY_COOLDOWN_MIN=30
ANOMALY_AI_MAX_PER_RUN=3

# ===== Client (Vite) =====
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/
